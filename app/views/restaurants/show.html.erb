<p style="color: green"><%= notice %></p>

<%= render @restaurant %>
<br>
<p><strong>--- Reviews ---</strong></p>
<ul class="list-group">
  <% @restaurant.reviews.each do |review| %>
    <li class="list-group-item"><%= review.content %></li>
  <% end %>
</ul>
<br>

<div>
  <%= link_to "Add review", new_restaurant_review_path(@restaurant) , class: "btn btn-success" %>
    <br><br>
  <%= link_to "Destroy this restaurant", @restaurant, method: :delete , class: "btn btn-danger"%>
     <br><br>
  <%= link_to "Back to restaurants", restaurants_path, class: "btn btn-primary"%>

  </div>
